{#
  Token pro interní API (ApiCsrfListener) + globální obal fetch.
  Musí být v <head> PŘED všemi skripty – přidá hlavičku X-CSRF-Token ke každému
  volání /api/* a /admin/api/* na stejné doméně (appky, inline skripty, přihlášení).
  Po vypršení session (403 + X-CSRF-Invalid) si vyžádá nový token a požadavek jednou zopakuje.
#}
<meta name="csrf-token" content="{{ csrf_token('api') }}">
<script>
(function () {
    var token = document.querySelector('meta[name="csrf-token"]').content;
    var originalFetch = window.fetch.bind(window);

    function isInternalApi(input) {
        var url = new URL(input instanceof Request ? input.url : String(input), location.href);
        return url.origin === location.origin && /^\/(admin\/)?api\//.test(url.pathname);
    }

    function withToken(input, init) {
        init = Object.assign({}, init);
        var headers = new Headers(init.headers || (input instanceof Request ? input.headers : undefined));
        headers.set('X-CSRF-Token', token);
        init.headers = headers;
        return init;
    }

    window.fetch = async function (input, init) {
        if (!isInternalApi(input)) {
            return originalFetch(input, init);
        }

        var response = await originalFetch(input, withToken(input, init));
        if (response.status === 403 && response.headers.get('X-CSRF-Invalid')) {
            var refreshed = await originalFetch('/api/auth/csrf-token', { credentials: 'same-origin' });
            if (refreshed.ok) {
                token = (await refreshed.json()).token;
                response = await originalFetch(input, withToken(input, init));
            }
        }
        return response;
    };
})();
</script>
