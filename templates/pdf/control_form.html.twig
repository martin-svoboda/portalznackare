{# PDF kontrolní formulář pro terénní práci #}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <title>Kontrolní formulář {{ head.Cislo_ZP ?? 'Příkaz' }}</title>
    <style>
        /* Self-hostovaný font Oswald embedovaný v base64 (DomPDF neumí CDN) */
        @font-face {
            font-family: 'Oswald';
            font-style: normal;
            font-weight: normal;
            src: url(data:font/truetype;charset=utf-8;base64,{{ font_oswald_regular }}) format('truetype');
        }
        @font-face {
            font-family: 'Oswald';
            font-style: normal;
            font-weight: bold;
            src: url(data:font/truetype;charset=utf-8;base64,{{ font_oswald_bold }}) format('truetype');
        }

        /* Základní styling pro PDF - optimalizováno pro DomPDF */
        body {
            font-family: 'DejaVu Sans', sans-serif;
            font-size: 10pt;
            line-height: 1.2;
            color: #000;
        }

        /* Oswald bold na H1 */
        h1 {
            font-family: 'Oswald', 'DejaVu Sans', sans-serif;
            font-weight: bold;
        }

        /* Tabulky úseků i TIM v Oswaldu regular (vizuální Tim_HTML náhled je v PDF vypnutý) */
        .lined-table,
        .lined-table th {
            font-family: 'Oswald', 'DejaVu Sans', sans-serif;
            font-weight: normal;
        }

        h1 {
            font-size: 14pt;
            margin-bottom: 0;
        }

        h2 {
            font-size: 12pt;
            margin-top: 4pt;
            margin-bottom: 2pt;
        }

        h3 {
            font-size: 10pt;
            margin-bottom: 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        .lined-table th {
            background-color: #dddddd;
            padding: 1mm;
            text-align: left;
            font-weight: bold;
            border: 1px solid #000;
            font-size: 7pt;
        }

        img {
            max-width: 100%;
            margin: 0 !important;
            display: block;
        }

        .lined-table > * > tr > td {
            padding: 1mm;
            border: 1px solid #000;
            vertical-align: top;
            font-size: 8pt;
        }

        /* Zalamování stránek */
        .no-break {
            page-break-inside: avoid;
        }

        tfoot {
            background-color: #f5f5f5;
        }
    </style>
</head>
<body>
{# Header #}
<div class="header-info" style="display:inline-block; width: 73%">
    <h1>Kontrolní formulář {{ head.Cislo_ZP ?? '' }}</h1>
    {{ head.Druh_ZP_Naz ?? '' }}
    {% if head.Popis_ZP %}
        {{ head.Popis_ZP|raw }}
    {% endif %}
    {% if head.Poznamka_ZP %}
        {{ head.Poznamka_ZP|raw }}
    {% endif %}
</div>
<div style="display:inline-block; width: 25%; height: 50px; border: 1px solid #000; padding: 1mm; font-size: 8pt;">
    Datum
</div>

{# Činnosti k vykázání (ZP-J) #}
{% if cinnosti is defined and cinnosti is not empty %}
    <h2>Činnosti</h2>
    <table class="lined-table">
        <thead>
        <tr>
            <th style="width: 8%;">Číslo</th>
            <th>Popis činnosti</th>
            <th style="width: 20%;">Provedeno</th>
        </tr>
        </thead>
        <tbody>
        {% for cinnost in cinnosti %}
            <tr>
                <td>{{ cinnost.Cis_Cinnosti ?? '' }}</td>
                <td>{{ cinnost.Popis_Cinnosti ?? '' }}</td>
                <td></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}

{# Úseky #}
{% if useky is not empty %}
    <h2>Úseky ke značení</h2>
    <table class="lined-table">
        <thead>
        <tr>
            <th style="width: 13%;">Značka</th>
            <th style="width: 40%;">Název úseku</th>
            <th style="width: 10%;">Délka</th>
            <th style="width: 37%;">Poznámka</th>
        </tr>
        </thead>
        <tbody>
        {% for usek in useky %}
            <tr>
                <td style="line-height: 1.7;">
                    {% if usek.Znacka_HTML %}
                        {{ usek.Znacka_HTML|raw }}
                    {% endif %}
                    <span>  {{ usek.Druh_Presunu ?? '' }} / {{ usek.Barva_Kod ?? '' }}</span>
                </td>
                <td>
                    <strong>{{ usek.Nazev_ZU|raw }}</strong><br>
                </td>
                <td style="text-align: right;">{{ usek.Delka_ZU|number_format(1, ',', ' ') }}</td>
                <td></td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
        <tr>
            <td colspan="2" style="text-align: right;"><strong>Celková délka:</strong></td>
            <td style="text-align: right;">
                <strong>{{ useky|reduce((sum, usek) => sum + usek.Delka_ZU, 0)|number_format(1, ',', ' ') }} km</strong>
            </td>
            <td></td>
        </tr>
        </tfoot>
    </table>
{% endif %}

{# ZP-I: prezentace po TIMech – co se na TIMu věší, co se svěšuje, co je servis (INSYZ-282).
   Mřížka je stejná jako u ZP-O, jen místo zpětné vazby k předmětům nese úkol a pole Provedeno. #}
{% if head.Druh_ZP is same as('S') %}
    {% if zpi_timy is defined and zpi_timy is not empty %}
        <h2>Instalace, odinstalace a servis (TIM)</h2>

        {% for tim in zpi_timy %}
            {% set servis = tim.items|filter(i => i.Cinnost == 'servis') %}
            {% set predmety_timu = tim.items|filter(i => i.Cinnost != 'servis') %}
            {# TIM jen se servisem nemá co dávat do druhého sloupce – hlavička i řádky jsou jednosloupcové #}
            {% set dva_sloupce = predmety_timu|length > 0 %}
            <div class="no-break">
                <table class="lined-table">
                    <thead>
                    <tr>
                        <th colspan="2">TIM {{ tim.EvCi_TIM }}: {{ tim.Naz_TIM|raw }}</th>
                        <th style="width: 8%;">Úkol</th>
                        <th style="width: 8%;">Provedeno</th>
                        {% if dva_sloupce %}
                            <th colspan="2"></th>
                            <th style="width: 8%;">Úkol</th>
                            <th style="width: 8%;">Provedeno</th>
                        {% endif %}
                    </tr>
                    </thead>
                    <tbody>
                    {% for item in servis %}
                        <tr class="no-break">
                            <td colspan="{{ dva_sloupce ? 6 : 2 }}" style="font-size: 7pt; line-height: 1.2;">
                                {% if item.TIM_Text|default('') %}<strong>{{ item.TIM_Text }}</strong>{% endif %}
                                {% if item.Popis|default('') %}<br>{{ item.Popis|nl2br }}{% endif %}
                                {% if item.Stav_Udrz_Naz|default('') %}<br>Stav údržby: {{ item.Stav_Udrz_Naz }}{% endif %}
                                {% if item.TIM_Text|default('') is empty and item.Popis|default('') is empty %}Servisní zásah bez bližšího popisu{% endif %}
                            </td>
                            <td style="width: 8%; font-size: 7pt;">Servis</td>
                            <td style="width: 8%; color: #999;">ANO / NE</td>
                        </tr>
                    {% endfor %}

                    {# Servisní TIM žádné předměty nemá – bez pojistky by 0..-1 sáhlo mimo pole #}
                    {% set half = ((predmety_timu|length) / 2)|round(0, 'ceil') %}
                    {% set col1 = predmety_timu|slice(0, half) %}
                    {% set col2 = predmety_timu|slice(half) %}
                    {% for i in (half > 0 ? 0..half - 1 : []) %}
                        <tr class="no-break">
                            {% for item in [col1[i], col2[i]|default(null)] %}
                                {% if item %}
                                    <td style="width: 7%; font-size: 7pt; line-height: 1;">
                                        {{ item.EvCi_TIM }}{{ item.Predmet_Index }}
                                        {% if item.Druh_Predmetu is not same as('M') and item.Druh_Predmetu is not same as('P') %}
                                            <br><span style="line-height: 2">{{ item.Znacka_HTML|raw }}  {{ item.Barva_Kod }}</span>
                                        {% endif %}
                                    </td>
                                    <td style="width: 27%; font-size: 7pt; line-height: 1;{% if item.Cinnost == 'odinstalace' %} text-decoration: line-through;{% endif %}">
                                        {{ item.Radek1|default('')|raw }}{% if item.KM1|default('') and (item.KM1 + 0) > 0 %} {{ (item.KM1 + 0) }} km{% endif %}
                                        {% set skip_radek2 = false %}
                                        {% if item.Druh_Predmetu is same as('M') and item.Nadmorska_vyska|default('') %}
                                            {% set vyska = item.Nadmorska_vyska|trim|trim('0')|trim('.') %}
                                            <br>{{ vyska }} m n.m.
                                            {% set r2 = item.Radek2|default('') %}
                                            {% set skip_radek2 = r2 and (vyska in r2 or 'm n.m.' in r2 or 'm n. m.' in r2) %}
                                        {% endif %}
                                        {% if item.Radek2|default('') and not skip_radek2 %}<br>{{ item.Radek2|raw }}{% if item.KM2|default('') and (item.KM2 + 0) > 0 %} {{ (item.KM2 + 0) }} km{% endif %}{% endif %}
                                        {% if item.Radek3|default('') %}<br>{{ item.Radek3|raw }}{% if item.KM3|default('') and (item.KM3 + 0) > 0 %} {{ (item.KM3 + 0) }} km{% endif %}{% endif %}
                                    </td>
                                    <td style="width: 8%; font-size: 7pt;">
                                        {{ item.Cinnost == 'odinstalace' ? 'Odinstalace' : 'Instalace' }}
                                    </td>
                                    <td style="width: 8%; color: #999;">ANO / NE</td>
                                {% else %}
                                    <td colspan="4"></td>
                                {% endif %}
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                    <tfoot>
                    <tr>
                        <td style="height: 60px" colspan="{{ dva_sloupce ? 8 : 4 }}"><span style="font-size: 8pt">Poznámka k TIM:</span></td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        {% endfor %}
    {% else %}
        <div style="margin-top: 20px; padding: 15px; background-color: #eff6ff; border-left: 4px solid #3b82f6;">
            <p style="margin: 0; color: #1e40af;">
                K tomuto příkazu nejsou žádné TIMy k instalaci, odinstalaci ani servisu.
            </p>
        </div>
    {% endif %}

{# TIM předměty - hlavní část formuláře (ZP-O) #}
{% elseif predmety is not empty %}
    {# Seskupení předmětů podle TIM #}
    {% set timGroups = {} %}
    {% for predmet in predmety %}
        {% if predmet.EvCi_TIM %}
            {% if timGroups[predmet.EvCi_TIM] is not defined %}
                {% set timGroups = timGroups|merge({
                    (predmet.EvCi_TIM): {
                        'EvCi_TIM': predmet.EvCi_TIM,
                        'Naz_TIM': predmet.Naz_TIM,
                        'GPS_Sirka': predmet.GPS_Sirka,
                        'GPS_Delka': predmet.GPS_Delka,
                        'items': []
                    }
                }) %}
            {% endif %}
            {% set currentGroup = timGroups[predmet.EvCi_TIM] %}
            {% set currentGroup = currentGroup|merge({
                'items': currentGroup.items|merge([predmet])
            }) %}
            {% set timGroups = timGroups|merge({
                (predmet.EvCi_TIM): currentGroup
            }) %}
        {% endif %}
    {% endfor %}

    {% if timGroups is not empty %}
        <h2>Stav tabulek a směrovek (TIM)</h2>

        {% for timId, timGroup in timGroups %}
            <div class="no-break">
                <table class="lined-table">
                    <thead>
                    <tr>
                        <th colspan="2">TIM {{ timGroup.EvCi_TIM }}: {{ timGroup.Naz_TIM|raw }}</th>
                        <th style="width: 5%;">Stav</th>
                        <th style="width: 10%;">Rok výroby</th>
                        <th style="width: 5%;">Směr</th>
                        <th colspan="2"></th>
                        <th style="width: 5%;">Stav</th>
                        <th style="width: 10%;">Rok výroby</th>
                        <th style="width: 5%;">Směr</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set half = ((timGroup.items|length) / 2)|round(0, 'ceil') %}
                    {% set col1 = timGroup.items|slice(0, half) %}
                    {% set col2 = timGroup.items|slice(half) %}
                    {% for i in 0..half - 1 %}
                        <tr class="no-break">
                            {% for item in [col1[i], col2[i]|default(null)] %}
                                {% if item %}
                                    <td style="width: 7%; font-size: 7pt; line-height: 1;">
                                        {{ item.EvCi_TIM }}{{ item.Predmet_Index }}
                                        {% if item.Druh_Predmetu is not same as('M') and item.Druh_Predmetu is not same as('P') %}
                                            <br><span style="line-height: 2">{{ item.Znacka_HTML|raw }}  {{ item.Barva_Kod }}</span>
                                        {% endif %}
                                    </td>
                                    <td style="width: 23%; font-size: 7pt; line-height: 1;">
                                        {{ item.Radek1|default('')|raw }}{% if item.KM1|default('') and (item.KM1 + 0) > 0 %} {{ (item.KM1 + 0) }} km{% endif %}
                                        {% set skip_radek2 = false %}
                                        {% if item.Druh_Predmetu is same as('M') and item.Nadmorska_vyska|default('') %}
                                            {% set vyska = item.Nadmorska_vyska|trim|trim('0')|trim('.') %}
                                            <br>{{ vyska }} m n.m.
                                            {% set r2 = item.Radek2|default('') %}
                                            {% set skip_radek2 = r2 and (vyska in r2 or 'm n.m.' in r2 or 'm n. m.' in r2) %}
                                        {% endif %}
                                        {% if item.Radek2|default('') and not skip_radek2 %}<br>{{ item.Radek2|raw }}{% if item.KM2|default('') and (item.KM2 + 0) > 0 %} {{ (item.KM2 + 0) }} km{% endif %}{% endif %}
                                        {% if item.Radek3|default('') %}<br>{{ item.Radek3|raw }}{% if item.KM3|default('') and (item.KM3 + 0) > 0 %} {{ (item.KM3 + 0) }} km{% endif %}{% endif %}
                                    </td>
                                    <td style="width: 5%; color: #999;">
                                        {% if item.Zachovalost|default('') %}
                                            {{ item.Zachovalost }}
                                        {% endif %}
                                    </td>
                                    <td style="width: 10%; color: #999;">
                                        {% if item.Druh_Predmetu is same as('P') %}
                                            —————
                                        {% elseif item.Rok_Vyroby|default('') %}
                                            {{ item.Rok_Vyroby }}
                                        {% endif %}
                                    </td>
                                    <td style="width: 5%; color: #999;">
                                        {% if item.Druh_Predmetu is same as('M') or item.Druh_Predmetu is same as('P') %}
                                            ——
                                        {% elseif item.Smerovani|default('') %}
                                            {{ item.Smerovani }}
                                        {% endif %}
                                    </td>
                                {% else %}
                                    <td colspan="5"></td>
                                {% endif %}
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                    <tfoot>
                    <tr>
                        <td style="height: 60px" colspan="7"><span style="font-size: 8pt">Poznámka k TIM:</span>
                        <td colspan="3">středové pravidlo <br><span style="font-weight: bold">ANO / NE</span></td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        {% endfor %}

        {# Stará detailní tabulka TIM s náhledy - dočasně vypnuta
        {% for timId, timGroup in timGroups %}
            <table class="lined-table">
                <thead>
                <tr>
                    <th colspan="8">TIM {{ timGroup.EvCi_TIM }}: {{ timGroup.Naz_TIM|raw }}</th>
                </tr>
                </thead>
                <tbody>
                {% for row in timGroup.items|batch(2) %}
                    <tr class="no-break">
                        {% for item in row %}
                            <td style="width: 27%;" rowspan="2">
                                {{ item.Tim_HTML|raw }}
                            </td>
                            <td style="width: 5%; height: 25px; color: #aaaaaa">stav</td>
                            <td style="width: 13%; height: 25px; color: #aaaaaa">rok výroby</td>
                            <td style="width: 5%; height: 25px; color: #aaaaaa">
                                {% if item.Druh_Predmetu_Naz and 'směrovka' in item.Druh_Predmetu_Naz|lower %}
                                    P/L
                                {% else %}
                                    –
                                {% endif %}
                            </td>
                        {% endfor %}
                        {% if row|length == 1 %}
                            <td rowspan="2" colspan="4"></td>
                        {% endif %}
                    </tr>
                    <tr class="no-break">
                        {% for item in row %}
                            <td style="color: #aaaaaa" colspan="3">poznámka</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                <tr>
                    <td style="width: 27%; height: 50px" colspan="8"><span style="font-size: 8pt;color: #aaaaaa">Poznámka k TIM:</span>
                    </td>
                </tr>
                </tfoot>
            </table>
        {% endfor %}
        #}
    {% endif %}
{% elseif head.Druh_ZP is same as('O') %}
    {# Jen u obnovy TIMy čekáme; ZP-J je vykázaný činnostmi, ne TIMy #}
    <div style="margin-top: 20px; padding: 15px; background-color: #eff6ff; border-left: 4px solid #3b82f6;">
        <p style="margin: 0; color: #1e40af;">
            Pro tento příkaz nejsou k dispozici žádné TIM k hodnocení.
        </p>
    </div>
{% endif %}

{# Footer #}
<div class="footer">
    <p>
        Portál značkaře - Kontrolní formulář<br>
        Vygenerováno: {{ generated_at|date('d.m.Y H:i') }}
    </p>
</div>

</body>
</html>
